@page
@model homework_1.Pages.CountriesModel

@{
    Layout = "Layout";
    ViewData["Title"] = "Countries";
}

<style>
    .list-element {
        list-style: none;
        border: aqua 3px solid;
        border-radius: 30px;
        background: aliceblue;
        padding: 15px;
        margin: 10px;
    }
    .parameter {
        font-style: italic;
        font-weight: bold;
    }
</style>

<h1 style="margin-left: 50px">Страны:</h1>
<ol style="font-size: 18px; padding-bottom: 100px;">
    @foreach(var country in @Model.Countries)
    {
        <li class="list-element">
            <div>
                <h2>@country.Name</h2>
                <p><span class="parameter">Столица</span> - @country.Capital</p>
                <p><span class="parameter">Население</span> - @country.Population тыс. чел.</p>
                
                <p>@country.Description</p>
                
                <p>
                    <span class="parameter">Города:</span> @string.Join(", ", country.Cities)
                </p>
                
            </div>
        </li>
    }
</ol>